# ~/.config/mako/config
# ====================================================
# Mako — Notification Daemon
# ====================================================

# ── Font & Layout ───────────────────────────────────
font=FiraCode Nerd Font 11
width=380
height=110
margin=15
padding=15,18
border-radius=10
border-size=2

# ── Colors (Catppuccin Mocha) ───────────────────────
# aa al final = transparencia (~67%)
background-color=#1e1e2eee
text-color=#cdd6f4
border-color=#89b4fa
progress-color=over #313244

# ── Behavior ────────────────────────────────────────
default-timeout=5000
ignore-timeout=1
layer=overlay
anchor=top-right
max-visible=5
sort=-time
icons=1
max-icon-size=48
icon-location=left

# ── Markup ──────────────────────────────────────────
markup=1
format=<b>%s</b>\n%b
actions=1

# ── Click behavior ──────────────────────────────────
# Left click → dismiss
# Right click → dismiss all
on-button-left=dismiss
on-button-right=dismiss-all
on-button-middle=none
on-touch=dismiss

# ====================================================
# Per-urgency overrides
# ====================================================

[urgency=low]
border-color=#6c7086
default-timeout=3000

[urgency=normal]
border-color=#89b4fa
default-timeout=5000

[urgency=high]
border-color=#f38ba8
text-color=#f38ba8
default-timeout=0
ignore-timeout=1

# ====================================================
# Per-app overrides — customize specific apps
# ====================================================

[app-name=Spotify]
border-color=#a6e3a1
default-timeout=3000

[app-name=Discord]
border-color=#cba6f7

[summary~="Volume.*"]
default-timeout=1500
border-color=#fab387

[category=mpd]
default-timeout=2000
group-by=category
